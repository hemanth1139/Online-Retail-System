# AWS Bedrock
AWS_REGION=ap-southeast-2
BEDROCK_MODEL_ID=apac.amazon.nova-micro-v1:0

# Authentication:
# Option A: Bedrock API key supported by your installed AWS SDK:
# AWS_BEARER_TOKEN_BEDROCK=your_bedrock_api_key
# Option B: configure standard AWS credentials outside this file
# (for example, aws configure / IAM role).

# Amazon RDS PostgreSQL
DB_HOST=your-rds-endpoint
DB_PORT=5432
DB_NAME=postgres
DB_USER=nl2sql_user
DB_PASSWORD=replace-with-your-db-password
DB_SCHEMA=public

# Safety limits
MAX_ROWS=100
STATEMENT_TIMEOUT_MS=15000
MAX_TOOL_ROUNDS=5
